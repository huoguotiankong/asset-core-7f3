/* Pornhub V2 Creator Center 0.2.0-test.2 */
  function creatorKindText(kind){kind=clean(kind);return kind==='channel'?'频道':kind==='model'?'模特':kind==='user'?'用户':'演员';}
  function creatorKindFromTab(kind){return kind==='channels'?'频道':kind==='models'?'模特':kind==='users'?'用户':'演员';}
  function creatorMetaText(p){var tp=creatorKindText(p&&p.personType),d=clean(p&&p.desc||'');d=d.replace(/\b(?:pornstar|channel|model|user)\b/ig,'').replace(/\bVideos?\b/ig,'部作品').replace(/\bSubscribers?\b/ig,'订阅').replace(/\bViews?\b/ig,'播放').replace(/^\s*[·•]\s*|\s*[·•]\s*$/g,'').replace(/\s*[·•]\s*[·•]\s*/g,' · ').replace(/\s+/g,' ');return d?tp+' · '+d:tp;}
  function creatorGridCard(p){return{title:p.name||'创作者',desc:creatorMetaText(p),pic_url:imageUrl(p.avatar,p.url),url:page('pornhubV2Creator',{u:p.url}),col_type:'icon_2_round',extra:{id:'phv2_creator_grid_'+hash(p.url),lineVisible:false}};}
  Pages.creators=function(){var kind=getMyVar('phv2_creator_kind','pornstars'),p=pageNo(),qv=clean(param('q','')),d=[],label=creatorKindFromTab(kind);UI.title('创作者');if(p===1){UI.section(d,'创作者中心','按类型浏览，也可以直接搜索');var k=[['演员','pornstars','creators'],['频道','channels','channel'],['模特','models','model'],['用户','users','account']],i;for(i=0;i<k.length;i++){(function(row){var active=kind===row[1];UI.add(d,{title:(active?'● ':'')+row[0],pic_url:icon(row[2]),url:$('#noLoading#').lazyRule(function(v){putMyVar('phv2_creator_kind',v);refreshPage(false);return'hiker://empty';},row[1]),col_type:'icon_small_4',extra:{lineVisible:false,id:'phv2_creator_type_'+row[1]}});})(k[i]);}UI.add(d,UI.input(qv,'搜索'+label+'名称','pornhubV2Creators'));}var r=CreatorProvider.list(kind,p,qv);if(p===1)UI.section(d,qv?('搜索 · '+qv):label,r.items.length?('本页 '+r.items.length+' 位'):'暂无结果');for(var j=0;j<r.items.length;j++)UI.add(d,creatorGridCard(r.items[j]));if(!r.items.length&&p===1)UI.empty(d,'暂未找到'+label,r.error||'可以切换类型或更换关键词。',r.url);setResult(d);};

