  Pages.home=function(){UI.title('Pornhub');var p=pageNo(),d=[],ready=Session.ready(),mode=getMyVar('phv2_home_mode',ready?'recommended':'recent'),name=Session.account();if(!ready&&(mode==='recommended'||mode==='feed'))mode='recent';if(p===1){UI.add(d,{title:ready?(name?'Pornhub · '+name:'Pornhub · 已登录'):'Pornhub',desc:ready?'账号推荐优先 · Local-First V2':'登录后优先显示账号推荐',pic_url:Session.avatar()?imageUrl(Session.avatar(),base()):icon('icon'),url:ready?page('pornhubV2Account'):page('pornhubV2Login'),col_type:'avatar',extra:{lineVisible:false}});UI.add(d,UI.input('','搜索视频、创作者…','pornhubV2Search'));UI.nav(d,'分类','categories',page('pornhubV2Categories'));UI.nav(d,'创作者','creators',page('pornhubV2Creators'));UI.nav(d,'收藏库','library',page('pornhubV2Library'));UI.nav(d,'我的','account',ready?page('pornhubV2Account'):page('pornhubV2Login'));var ms=[['为你推荐','recommended'],['Feed','feed'],['最新','recent'],['热门','viewed'],['高分','rated']],i;for(i=0;i<ms.length;i++)UI.add(d,UI.tab(ms[i][0],mode===ms[i][1],$('#noLoading#').lazyRule(function(v){try{$.require('pornhub').homeMode(v);return'hiker://empty';}catch(e){putMyVar('phv2_home_mode',v);refreshPage(false);return'hiker://empty';}},ms[i][1]),'phv2_home_tab_'+ms[i][1]));UI.section(d,mode==='recommended'?'为你推荐':mode==='feed'?'Feed':mode==='recent'?'最新':mode==='viewed'?'热门':'高分','', 'phv2_home_feed_title');UI.add(d,{title:'',url:'hiker://empty',col_type:'line',extra:{id:'phv2_home_feed_anchor',lineVisible:false}});}var r=VideoProvider.home(mode,p);UI.videos(d,r.items,p===1?18:r.items.length,p===1?'phv2_home_feed_body':null);if(!r.items.length&&p===1)UI.empty(d,'暂时没有可展示内容',r.error||'可以切换“最新”或在官方页确认网络状态。',r.url||base()+'/video');if(p===1){UI.section(d,'更多发现','Shorts · 片单 · GIF');UI.action(d,'Shorts','shorts',page('pornhubV2Shorts'));UI.action(d,'片单','playlist',page('pornhubV2Playlists'));UI.action(d,'GIF','gifs',page('pornhubV2Gifs'));}setResult(d);};

  Pages.search=function(){var qv=clean(param('q','')),p=pageNo(),d=[];UI.title(qv?'搜索 · '+qv:'搜索');if(p===1){UI.add(d,UI.input(qv,'搜索视频、创作者…','pornhubV2Search'));}if(!qv){if(p===1){UI.searchHistory(d);var hub=CategoryProvider.hub(false),hot=hub.popular.slice(0,10),i;UI.section(d,'热门分类','点击即可浏览');for(i=0;i<hot.length;i++)UI.add(d,{title:hot[i].name,col_type:'flex_button',url:page('pornhubV2Category',{u:hot[i].url,n:hot[i].name}),extra:{lineVisible:false}});UI.section(d,'搜索建议','输入关键词后可切换视频 / 创作者，并展开高级筛选。');}setResult(d);return;}if(p===1)Store.pushSearch(qv);var scope=getMyVar('phv2_search_scope','video'),show=getMyVar('phv2_search_filter','0')==='1';if(p===1){UI.add(d,UI.tab('视频',scope==='video',$('#noLoading#').lazyRule(function(){putMyVar('phv2_search_scope','video');refreshPage(false);return'hiker://empty';}),'phv2_search_scope_video','flex_button'));UI.add(d,UI.tab('创作者',scope==='creator',$('#noLoading#').lazyRule(function(){putMyVar('phv2_search_scope','creator');refreshPage(false);return'hiker://empty';}),'phv2_search_scope_creator','flex_button'));if(scope==='video')UI.add(d,{title:show?'收起筛选':'筛选',desc:'排序 / 制作类型 / 时长',col_type:'text_1',url:$('#noLoading#').lazyRule(function(){putMyVar('phv2_search_filter',getMyVar('phv2_search_filter','0')==='1'?'0':'1');refreshPage(false);return'hiker://empty';}),extra:{lineVisible:false}});}if(scope==='creator'){var kind=getMyVar('phv2_search_creator_kind','pornstars');if(p===1){var ka=[['演员','pornstars'],['频道','channels'],['模特','models'],['用户','users']],ki;for(ki=0;ki<ka.length;ki++)UI.add(d,UI.tab(ka[ki][0],kind===ka[ki][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_search_creator_kind',v);refreshPage(false);return'hiker://empty';},ka[ki][1]),'', 'flex_button'));}var cr=CreatorProvider.list(kind,p,qv);if(p===1)UI.section(d,'创作者结果',cr.items.length?'找到 '+cr.items.length+' 位':'暂无结果');UI.persons(d,cr.items);if(!cr.items.length&&p===1)UI.empty(d,'没有找到创作者',cr.error||'可以更换关键词或类型。',cr.url);setResult(d);return;}var order=getMyVar('phv2_search_order',''),prod=getMyVar('phv2_search_prod',''),duration=getMyVar('phv2_search_duration','all'),min='',max='';if(duration==='lt10')max='10';else if(duration==='10_20'){min='10';max='20';}else if(duration==='20_30'){min='20';max='30';}else if(duration==='30p')min='30';if(p===1&&show){UI.section(d,'排序','');var os=[['相关',''],['最新','mr'],['最多观看','mv'],['最高评分','tr']],i;for(i=0;i<os.length;i++)UI.add(d,UI.tab(os[i][0],order===os[i][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_search_order',v);refreshPage(false);return'hiker://empty';},os[i][1]),'','flex_button'));UI.section(d,'制作类型','');var ps=[['全部',''],['专业','professional'],['自制','homemade']];for(i=0;i<ps.length;i++)UI.add(d,UI.tab(ps[i][0],prod===ps[i][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_search_prod',v);refreshPage(false);return'hiker://empty';},ps[i][1]),'','flex_button'));UI.section(d,'时长','');var ds=[['全部','all'],['<10分钟','lt10'],['10–20','10_20'],['20–30','20_30'],['30+','30p']];for(i=0;i<ds.length;i++)UI.add(d,UI.tab(ds[i][0],duration===ds[i][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_search_duration',v);refreshPage(false);return'hiker://empty';},ds[i][1]),'','flex_button'));}var vr=VideoProvider.search(qv,p,{order:order,production:prod,min:min,max:max});if(p===1)UI.section(d,'视频结果',vr.items.length?'找到 '+vr.items.length+' 个':'暂无结果');UI.videos(d,vr.items);if(!vr.items.length&&p===1)UI.empty(d,'没有匹配视频',vr.error||'可以更换关键词或筛选条件。',vr.url);setResult(d);};

  Pages.nativeSearch=function(){var qv='';try{qv=clean(MY_KEYWORD||'');}catch(e){qv=clean(param('q',''));}var d=[],r=VideoProvider.search(qv,pageNo(),{});UI.videos(d,r.items);if(!r.items.length&&pageNo()===1)UI.empty(d,'没有搜索结果','',r.url);setResult(d);};

  Pages.categories=function(){UI.title('分类');var d=[],group=getMyVar('phv2_category_group','straight'),expanded=getMyVar('phv2_category_all','0')==='1',hub=CategoryProvider.hub(false),i,x,pop=[],all=[];var tabs=[['异性恋','straight'],['男同','gay'],['女女','lesbian']];for(i=0;i<tabs.length;i++)UI.add(d,UI.tab(tabs[i][0],group===tabs[i][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_category_group',v);refreshPage(false);return'hiker://empty';},tabs[i][1]),'', 'flex_button'));for(i=0;i<hub.popular.length;i++)if(hub.popular[i].group===group)pop.push(hub.popular[i]);for(i=0;i<hub.all.length;i++)if(hub.all[i].group===group)all.push(hub.all[i]);UI.section(d,'热门类型',pop.length?'精选 '+Math.min(pop.length,10)+' 个':'当前没有解析到图片分类');for(i=0;i<pop.length&&i<10;i++){x=pop[i];UI.add(d,{title:x.name,pic_url:imageUrl(x.cover,x.url),url:page('pornhubV2Category',{u:x.url,n:x.name}),col_type:'movie_2',extra:{lineVisible:false}});}UI.section(d,'全部类型','共 '+all.length+' 个');var limit=expanded?all.length:Math.min(18,all.length);for(i=0;i<limit;i++){x=all[i];UI.add(d,{title:x.name,url:page('pornhubV2Category',{u:x.url,n:x.name}),col_type:'flex_button',extra:{lineVisible:false}});}if(all.length>18)UI.add(d,{title:expanded?'收起全部分类':'查看全部 '+all.length+' 个',col_type:'text_center_1',url:$('#noLoading#').lazyRule(function(){putMyVar('phv2_category_all',getMyVar('phv2_category_all','0')==='1'?'0':'1');refreshPage(false);return'hiker://empty';}),extra:{lineVisible:false}});if(!pop.length&&!all.length)UI.empty(d,'分类暂不可用',hub.error||'站点分类结构可能发生变化。',hub.url);setResult(d);};

  Pages.category=function(){var u=clean(param('u',base()+'/video')),n=clean(param('n','分类')),p=pageNo(),order=getMyVar('phv2_category_order','mr'),d=[];UI.title(n);if(p===1){var os=[['最新','mr'],['最多观看','mv'],['最高评分','tr']],i;for(i=0;i<os.length;i++)UI.add(d,UI.tab(os[i][0],order===os[i][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_category_order',v);refreshPage(false);return'hiker://empty';},os[i][1])));}var r=CategoryProvider.videos(u,p,order);UI.videos(d,r.items);if(!r.items.length&&p===1)UI.empty(d,'该分类暂无可展示内容',r.error||'','');setResult(d);};

  function detailIntroItems(v,u,cls){var a=[],isFav=Store.contains(KEYS.favVideo,u),i;UI.action(a,isFav?'取消本地收藏':'本地收藏','local',localToggleLazy('video',localItem('video',{url:u,title:v.title,cover:v.cover,desc:[v.duration,v.views].filter(function(x){return!!x;}).join(' · ')})));UI.action(a,'站内收藏','favorite',onlineFavoriteLazy(u));UI.action(a,'官方页面','official','x5://'+u);if(v.creator){UI.section(a,'创作者','');var pc=UI.person(v.creator);pc.extra.cls=cls;a.push(pc);}if(v.desc){UI.section(a,'简介','');a.push({title:v.desc,url:'hiker://empty',col_type:'rich_text',extra:{cls:cls,lineVisible:false}});}if(v.categories&&v.categories.length){UI.section(a,'分类','');for(i=0;i<v.categories.length;i++)a.push({title:zhCategory(v.categories[i].name,v.categories[i].url),url:page('pornhubV2Category',{u:v.categories[i].url,n:zhCategory(v.categories[i].name,v.categories[i].url)}),col_type:'flex_button',extra:{cls:cls,lineVisible:false}});}if(v.tags&&v.tags.length){UI.section(a,'标签','');for(i=0;i<v.tags.length;i++)a.push({title:zhCategory(v.tags[i].name,v.tags[i].url),url:page('pornhubV2Category',{u:v.tags[i].url,n:zhCategory(v.tags[i].name,v.tags[i].url)}),col_type:'flex_button',extra:{cls:cls,lineVisible:false}});}if(v.related&&v.related.length){UI.section(a,'相关推荐','');UI.videos(a,v.related,16,cls);}for(i=0;i<a.length;i++){a[i].extra=a[i].extra||{};a[i].extra.cls=cls;}return a;}
  function detailCommentItems(u,cls){var d=[],r=VideoProvider.comments(u),i,c,row;if(r.items.length){UI.section(d,'评论',r.count?(r.count+' 条'):(r.items.length+' 条'));for(i=0;i<r.items.length;i++){c=r.items[i];row={title:c.author.name||'用户',desc:[c.time,c.likeCount?('👍 '+c.likeCount):''].filter(function(x){return!!x;}).join(' · '),pic_url:imageUrl(c.author.avatar,u),url:'hiker://empty',col_type:'avatar',extra:{cls:cls,lineVisible:false}};d.push(row);d.push({title:c.content,url:'hiker://empty',col_type:'long_text',extra:{cls:cls,lineVisible:false}});d.push({col_type:'line_blank',extra:{cls:cls}});}}else{UI.section(d,'暂未解析到评论',r.error||'评论可能由当前页面异步加载。');UI.line(d,'在官方评论区查看','只读解析失败时使用官方页面','x5://'+u);}for(i=0;i<d.length;i++){d[i].extra=d[i].extra||{};d[i].extra.cls=cls;}return d;}

  Pages.detail=function(){var u=clean(param('u','')),d=[];UI.title('视频详情');if(!u){UI.empty(d,'缺少视频地址','请从列表重新进入。');setResult(d);return;}var v=VideoProvider.detail(u,false);if(!v){UI.empty(d,'详情加载失败','原站可能返回验证页或网络异常。',u);setResult(d);return;}UI.title(v.title);UI.add(d,{title:'',pic_url:imageUrl(v.cover,u),url:playLazy(u),col_type:'pic_1_full',extra:{lineVisible:false}});UI.line(d,v.title,[v.duration,v.views?v.views+' views':'',v.date].filter(function(x){return!!x;}).join(' · '),'hiker://empty');UI.line(d,'▶ 立即播放',v.sources&&v.sources.length?(v.sources.length+' 个 HLS 画质'):'未找到结构化直链，将使用媒体提取',playLazy(u));var key='phv2_detail_tab_'+hash(u),tab=getMyVar(key,'intro');UI.add(d,UI.tab('简介',tab==='intro',$('#noLoading#').lazyRule(function(target,t,k){try{$.require('pornhub').detailTab(target,t);return'hiker://empty';}catch(e){putMyVar(k,t);refreshPage(false);return'hiker://empty';}},u,'intro',key),'phv2_detail_intro','text_2'));UI.add(d,UI.tab('评论',tab==='comments',$('#noLoading#').lazyRule(function(target,t,k){try{$.require('pornhub').detailTab(target,t);return'hiker://empty';}catch(e){putMyVar(k,t);refreshPage(false);return'hiker://empty';}},u,'comments',key),'phv2_detail_comments','text_2'));UI.add(d,{col_type:'line',url:'hiker://empty',extra:{id:'phv2_detail_anchor',lineVisible:false}});var items=tab==='comments'?detailCommentItems(u,'phv2_detail_body'):detailIntroItems(v,u,'phv2_detail_body'),i;for(i=0;i<items.length;i++)d.push(items[i]);setResult(d);};

  Pages.comments=function(){var u=clean(param('u','')),d=[];UI.title('评论');if(!u){UI.empty(d,'缺少视频地址','');setResult(d);return;}var x=detailCommentItems(u,'');for(var i=0;i<x.length;i++)d.push(x[i]);setResult(d);};

  Pages.creators=function(){var kind=getMyVar('phv2_creator_kind','pornstars'),p=pageNo(),qv=clean(param('q','')),d=[];UI.title('创作者');if(p===1){var k=[['演员','pornstars'],['频道','channels'],['模特','models'],['用户','users']],i;for(i=0;i<k.length;i++)UI.add(d,UI.tab(k[i][0],kind===k[i][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_creator_kind',v);refreshPage(false);return'hiker://empty';},k[i][1]),'','flex_button'));UI.add(d,UI.input(qv,'搜索当前创作者类型','pornhubV2Creators'));}var r=CreatorProvider.list(kind,p,qv);UI.persons(d,r.items);if(!r.items.length&&p===1)UI.empty(d,'暂未识别到创作者',r.error||'可以切换类型或在官方页核对。',r.url);setResult(d);};

