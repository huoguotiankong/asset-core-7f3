  Pages.creator=function(){var u=clean(param('u','')),d=[];UI.title('创作者');if(!u){UI.empty(d,'缺少创作者地址','');setResult(d);return;}var x=CreatorProvider.detail(u,false);if(!x){UI.empty(d,'创作者加载失败','',u);setResult(d);return;}UI.title(x.name);UI.add(d,{title:x.name,desc:x.desc||x.personType||'',pic_url:imageUrl(x.avatar,u),url:'hiker://empty',col_type:'avatar',extra:{lineVisible:false}});var fav=Store.contains(KEYS.favPerson,u);UI.action(d,'在线订阅','subscribe',subscribeLazy(u));UI.action(d,fav?'取消本地收藏':'本地收藏','local',localToggleLazy('person',localItem('person',{url:u,title:x.name,cover:x.avatar,desc:x.personType})));UI.action(d,'官方主页','official','x5://'+u);var tab=getMyVar('phv2_creator_tab_'+hash(u),'works');var ckey='phv2_creator_tab_'+hash(u);UI.add(d,UI.tab('作品',tab==='works',$('#noLoading#').lazyRule(function(k){putMyVar(k,'works');refreshPage(false);return'hiker://empty';},ckey),'','text_2'));UI.add(d,UI.tab('简介',tab==='about',$('#noLoading#').lazyRule(function(k){putMyVar(k,'about');refreshPage(false);return'hiker://empty';},ckey),'','text_2'));if(tab==='about'){UI.section(d,'简介','');UI.line(d,x.desc||'暂无公开简介',x.personType||'','hiker://empty');}else{UI.section(d,'公开视频',x.videos.length?(x.videos.length+' 个'):'暂无可展示作品');UI.videos(d,x.videos);}setResult(d);};

  function renderLocalLibrary(d,kind){var key=kind==='person'?KEYS.favPerson:kind==='collection'?KEYS.favCollection:kind==='history'?KEYS.history:KEYS.favVideo,a=Store.list(key),i,x;if(!a.length){UI.section(d,'这里还是空的',kind==='history'?'浏览过的视频会保存在这里':'收藏后会出现在这里');return;}if(kind==='person'){for(i=0;i<a.length;i++){x={name:a[i].title,avatar:a[i].cover,url:a[i].url,desc:a[i].desc,type:'person'};d.push(UI.person(x));}}else if(kind==='collection'){for(i=0;i<a.length;i++){x={title:a[i].title,cover:a[i].cover,url:a[i].url,desc:a[i].desc,type:'collection'};d.push(UI.collection(x));}}else{for(i=0;i<a.length;i++){x={title:a[i].title,cover:a[i].cover,url:a[i].url,desc:a[i].desc,type:'video'};d.push(UI.video(x));}}}
  Pages.library=function(){UI.title('收藏库');var d=[],scope=getMyVar('phv2_library_scope','local'),kind=getMyVar('phv2_library_kind',scope==='local'?'video':'favorites');UI.add(d,UI.tab('本地',scope==='local',$('#noLoading#').lazyRule(function(){putMyVar('phv2_library_scope','local');putMyVar('phv2_library_kind','video');refreshPage(false);return'hiker://empty';}),'','text_2'));UI.add(d,UI.tab('账号',scope==='account',$('#noLoading#').lazyRule(function(){putMyVar('phv2_library_scope','account');putMyVar('phv2_library_kind','favorites');refreshPage(false);return'hiker://empty';}),'','text_2'));if(scope==='local'){var a=[['影片','video'],['创作者','person'],['片单','collection'],['足迹','history']],i;for(i=0;i<a.length;i++)UI.add(d,UI.tab(a[i][0],kind===a[i][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_library_kind',v);refreshPage(false);return'hiker://empty';},a[i][1])));renderLocalLibrary(d,kind);setResult(d);return;}if(!Session.ready()){UI.empty(d,'还没有登录','账号收藏、观看历史和订阅需要 X5 登录会话。',base()+'/login');UI.line(d,'去登录','',''+page('pornhubV2Login'));setResult(d);return;}var b=[['站内收藏','favorites'],['观看历史','history'],['订阅','subscriptions']],j;for(j=0;j<b.length;j++)UI.add(d,UI.tab(b[j][0],kind===b[j][1],$('#noLoading#').lazyRule(function(v){putMyVar('phv2_library_kind',v);refreshPage(false);return'hiker://empty';},b[j][1])));if(!Session.identityReady()){UI.section(d,'账号身份尚未完成校验','当前 Cookie 已登录，但没有从官方安全页确认当前用户名。为了避免再次显示错账号的收藏/订阅，本版不会猜测。');UI.line(d,'X5 核对官方账号','确认当前 X5 登录的是哪个账号','x5://'+base()+'/user/security');UI.line(d,'重新同步登录','返回后重新读取 Cookie',page('pornhubV2Login'));setResult(d);return;}if(kind==='subscriptions'){var sr=AccountProvider.subscriptions(pageNo());UI.persons(d,sr.items);if(!sr.items.length)UI.empty(d,'没有解析到订阅',sr.error||'以官方账号页面为准。',sr.url);setResult(d);return;}var vr=AccountProvider.videos(kind,pageNo());UI.videos(d,vr.items);if(!vr.items.length)UI.empty(d,'没有解析到账号内容',vr.error||'以官方账号页面为准。',vr.url);setResult(d);};

  Pages.login=function(){UI.title('Pornhub 登录');var d=[],ready=Session.ready();UI.add(d,{title:'官方 X5 登录',desc:'密码、验证码和二次验证全部在 Pornhub 官方页面完成，本小程序不保存密码。',pic_url:icon('account'),url:'x5://'+base()+'/login',col_type:'movie_1_left_pic',extra:{lineVisible:false}});UI.section(d,'登录流程','① 打开官方登录页 → ② 登录成功返回海阔 → ③ 同步 X5 会话');UI.line(d,'同步 X5 登录会话',ready?'当前已有会话，可重新校验':'读取当前 X5 Cookie 并核验官方账号安全页',$('#noLoading#').lazyRule(function(){try{var r=$.require('pornhub').syncAccount();refreshPage(false);return'toast://'+r.message;}catch(e){return'toast://同步失败：'+String(e.message||e);}}));UI.line(d,'X5 查看账号安全页','用于确认当前 X5 到底登录的是哪个账号','x5://'+base()+'/user/security');if(ready)UI.line(d,'进入我的账号','',page('pornhubV2Account'));setResult(d);};

  Pages.account=function(){UI.title('我的');var d=[],ready=Session.ready(),identity=Session.identityReady(),name=Session.account(),avatar=Session.avatar();UI.add(d,{title:ready?(identity?name:'Pornhub X5 会话'):'未登录',desc:ready?(identity?'账号身份已由官方安全页确认':'会话已登录 · 身份待确认'):'使用 X5 官方网页登录',pic_url:avatar?imageUrl(avatar,base()):icon('account'),url:ready?'hiker://empty':page('pornhubV2Login'),col_type:'avatar',extra:{lineVisible:false}});if(!ready){UI.nav(d,'登录','account',page('pornhubV2Login'));UI.nav(d,'分类','categories',page('pornhubV2Categories'));UI.nav(d,'创作者','creators',page('pornhubV2Creators'));UI.nav(d,'收藏库','library',page('pornhubV2Library'));setResult(d);return;}UI.nav(d,'为你推荐','home',$('#noLoading#').lazyRule(function(){putMyVar('phv2_home_mode','recommended');return'hiker://home@'+MY_RULE.title;}));UI.nav(d,'Feed','feed',$('#noLoading#').lazyRule(function(){putMyVar('phv2_home_mode','feed');return'hiker://home@'+MY_RULE.title;}));UI.nav(d,'收藏库','library',page('pornhubV2Library'));UI.nav(d,'官方账号','official','x5://'+base()+'/user/security');UI.section(d,'账号会话',identity?'私有收藏 / 历史 / 订阅已解锁':'为了避免错账号，私有列表保持锁定，直到官方安全页确认用户名。');UI.line(d,'重新同步登录','重新读取当前 X5 Cookie',$('#noLoading#').lazyRule(function(){try{var r=$.require('pornhub').syncAccount();refreshPage(false);return'toast://'+r.message;}catch(e){return'toast://'+String(e.message||e);}}));UI.line(d,'退出本小程序会话','不会删除 Pornhub 官方 X5 Cookie',$('#noLoading#').lazyRule(function(){try{$.require('pornhub').logout();refreshPage(false);return'toast://本小程序账号会话已退出';}catch(e){return'toast://'+String(e.message||e);}}));setResult(d);};

  Pages.shorts=function(){UI.title('Shorts');var d=[],r=ShortsProvider.list(pageNo());UI.section(d,'Shorts',r.items.length?('找到 '+r.items.length+' 个真实短视频实体'):'当前页没有识别到完整 Short 实体');UI.videos(d,r.items);if(!r.items.length&&pageNo()===1)UI.empty(d,'Shorts 暂未原生化','只有同时取得真实 /shorties/<id>、标题和封面才会建卡；不会再显示伪 Short。',r.url);setResult(d);};
  Pages.playlists=function(){UI.title('片单');var d=[],r=CollectionProvider.list(pageNo());UI.section(d,'公开片单',r.items.length?('找到 '+r.items.length+' 个完整片单'):'当前页没有识别到完整片单');UI.collections(d,r.items);if(!r.items.length&&pageNo()===1)UI.empty(d,'片单暂未原生化','只有真实标题、封面和 playlist URL 同时存在才建卡。',r.url);setResult(d);};
  Pages.playlist=function(){var u=clean(param('u','')),seed=clean(param('n','')),seedIm=clean(param('im','')),d=[];UI.title(seed||'片单');if(!u){UI.empty(d,'缺少片单地址','');setResult(d);return;}var loaded=parseInt(getMyVar('phv2_playlist_loaded_'+hash(u),'1'),10)||1,first=CollectionProvider.detail(u,1),title=first.title||seed,cover=first.cover||seedIm,i,p,videos=[],seen={};if(!title||!cover){UI.empty(d,'片单信息不完整','当前页面没有同时取得真实标题与封面，不生成伪片单。',u);setResult(d);return;}UI.title(title);UI.add(d,{title:title,desc:first.itemCount?('共 '+first.itemCount+' 个视频'):(first.desc||''),pic_url:imageUrl(cover,u),url:'hiker://empty',col_type:'movie_1_left_pic',extra:{lineVisible:false}});var fav=Store.contains(KEYS.favCollection,u);UI.action(d,fav?'取消本地收藏':'本地收藏','local',localToggleLazy('collection',localItem('collection',{url:u,title:title,cover:cover,desc:first.desc})));UI.action(d,'官方片单','official','x5://'+u);UI.action(d,'收藏库','library',page('pornhubV2Library'));for(p=1;p<=loaded;p++){var x=CollectionProvider.detail(u,p);for(i=0;i<x.items.length;i++)if(!seen[x.items[i].url]){seen[x.items[i].url]=1;videos.push(x.items[i]);}}UI.section(d,'片单视频',first.itemCount?('已加载 '+videos.length+' / '+first.itemCount):('已加载 '+videos.length+' 个'));UI.videos(d,videos);if(first.pages&&loaded<first.pages)UI.add(d,{title:'加载更多 · 第 '+(loaded+1)+' / '+first.pages+' 页',url:$('#noLoading#').lazyRule(function(k,n){putMyVar(k,String(n));refreshPage(false);return'hiker://empty';},'phv2_playlist_loaded_'+hash(u),loaded+1),col_type:'text_center_1',extra:{lineVisible:false}});if(!videos.length)UI.empty(d,'没有解析到片单视频','',u);setResult(d);};

  Pages.gifs=function(){UI.title('GIF');var d=[],r=GifProvider.list(pageNo(),'');UI.section(d,'GIF',r.items.length?('找到 '+r.items.length+' 个'):'暂无结果');var i,g;for(i=0;i<r.items.length;i++){g=r.items[i];UI.add(d,{title:g.title,desc:'GIF',pic_url:imageUrl(g.cover,g.url),url:'x5://'+g.url,col_type:'movie_2',extra:{lineVisible:false}});}if(!r.items.length&&pageNo()===1)UI.empty(d,'GIF 暂不可用',r.error||'',r.url);setResult(d);};

  Pages.settings=function(){UI.title('设置');var d=[],b=base();UI.section(d,'体验','V2 Product-First · Local-First');UI.line(d,'当前站点',b,'input://'+JSON.stringify({value:b,hint:'https://www.pornhub.com',js:"(function(){var v=String(input||'').trim().replace(/\\/+$/,'');if(!/^https?:\\/\\//i.test(v))return 'toast://请输入完整 https:// 地址';setItem('"+KEYS.base+"',v);refreshPage(false);return 'toast://站点地址已更新';})()"}));UI.line(d,'账号',Session.ready()?(Session.identityReady()?('已验证 · '+Session.account()):'已登录 · 身份待确认'):'未登录',Session.ready()?page('pornhubV2Account'):page('pornhubV2Login'));UI.section(d,'本地数据','收藏、足迹和搜索记录均保存在本机');UI.line(d,'收藏库','影片 '+Store.list(KEYS.favVideo).length+' · 创作者 '+Store.list(KEYS.favPerson).length+' · 片单 '+Store.list(KEYS.favCollection).length,page('pornhubV2Library'));UI.line(d,'清空搜索记录',Store.searchHistory().length+' 条',$('#noLoading#').lazyRule(function(){try{$.require('pornhub').clearSearch();return'toast://搜索记录已清空';}catch(e){return'toast://'+String(e.message||e);}}));UI.line(d,'清空本地足迹',Store.list(KEYS.history).length+' 条',$('#noLoading#').lazyRule(function(){try{$.require('pornhub').clearHistory();return'toast://本地足迹已清空';}catch(e){return'toast://'+String(e.message||e);}}));UI.section(d,'维护','程序代码由 Local-First Runtime 提供，更新由“我的规则仓库”统一管理');UI.line(d,'运行诊断',VERSION+' · Build '+BUILD,page('pornhubV2Diagnostics'));UI.line(d,'官方站点','', 'x5://'+b+'/');setResult(d);};

  Pages.diagnostics=function(){UI.title('运行诊断');var d=[],m={};try{var f=ROOT+'bundle_meta.json';if(fileExist(f))m=JSON.parse(readFile(f)||'{}');}catch(e){}UI.section(d,'Runtime','');UI.line(d,'版本',VERSION+' · Build '+BUILD+' · Standalone Local-First','hiker://empty');UI.line(d,'本地包',m&&Number(m.build||0)===BUILD?('已就绪 · '+String(m.sources||0)+' 源 · '+String(m.assets||0)+' 资产'):'状态待确认','hiker://empty');UI.line(d,'代码来源',m.sourceRef?String(m.sourceRef).slice(0,12):'首次安装后记录','hiker://empty');UI.section(d,'账号会话','不显示 Cookie / Token / Authorization');UI.line(d,'X5 会话',Session.ready()?'已启用':'未启用','hiker://empty');UI.line(d,'身份校验',Session.identityReady()?('已确认 · '+Session.account()):'未确认','hiker://empty');UI.line(d,'会话指纹',Session.ready()?Session.fingerprint().slice(0,10):'','hiker://empty');UI.section(d,'业务合同','播放：mediaDefinitions → HLS PlayModel → video:// 兜底\n评论：详情 HTML → 评论候选 AJAX\nShorts：真实 /shorties/<id> + 标题 + 封面\n片单：真实 title + cover + /playlist/<id>，chunk 按需加载');UI.line(d,'重建本地包','删除当前 Runtime/Assets 后从不可变 Source Ref 重新安装',$('#noLoading#').lazyRule(function(){try{var e='hiker://files/rules/asset-core-local/pornhub-test/b20001/local_entry.js',u=getPath(e);try{require(u);}catch(e0){try{deleteCache(u);}catch(e1){}require(u);}PornhubLocalV2.rebuild();return'toast://本地包已重建';}catch(ex){return'toast://重建失败：'+String(ex.message||ex);}}));setResult(d);};

